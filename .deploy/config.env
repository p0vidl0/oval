# Non-secret deploy config (committed). Secrets: `secrets.env` from GitHub Actions.

OVAL_DOMAIN=velodrom55.ru

# Яндекс.Метрика (публичный id счётчика; загрузка после согласия в баннере)
YANDEX_METRIKA_COUNTER_ID=113587963

# First-party аналитика (Postgres) + страница /privacy
OVAL_ANALYTICS_ENABLED=1
OVAL_PRIVACY_CONTACT_EMAIL=noreply@velodrom55.ru
OVAL_PRIVACY_OPERATOR_NAME=Ночная лига
TRAEFIK_NETWORK=web
TRAEFIK_CERT_RESOLVER=myresolver

NODE_ENV=production
BETTER_AUTH_URL=https://velodrom55.ru
BETTER_AUTH_TRUSTED_PROXIES=172.16.0.0/12

EMAIL_PROVIDER=smtp
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_FROM=noreply@velodrom55.ru
SMTP_SECURE=0

PAYMENT_PROVIDER=mock

# Публичный id канала для autopublish (@channel или -100…). Бот — админ канала.
TELEGRAM_CHANNEL_ID="-1002067773832"

# Bot API reverse proxy — GitHub secret TELEGRAM_API_ROOT (попадает в secrets.env). Без слэша в конце.
# OIDC reverse proxy — GitHub secret TELEGRAM_OIDC_ROOT (серверные /token и JWKS). Без слэша в конце.

# Лимит тела Server Action (фото в форме). По умолчанию считается в lib/config/upload-limits.ts.
# Применяется при сборке образа — раскомментируйте и задайте build-arg в CI/Dockerfile:
# SERVER_ACTION_BODY_SIZE_LIMIT=52mb
