# Copy to oval-dev.local.env (gitignored). Overrides generated oval-dev.env.
# Optional: replace dev profile secret (openssl rand -base64 32)
# BETTER_AUTH_SECRET=

# Telegram OIDC (BotFather mini app → Web Login → Client ID + Secret)
# TELEGRAM_OIDC_CLIENT_ID=
# TELEGRAM_OIDC_CLIENT_SECRET=
# Bot deep link + webhook (bot token from BotFather; username without @)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# Mini App short name (BotFather) — для ссылок t.me/bot/shortname?startapp=...
# TELEGRAM_MINI_APP_SHORT_NAME=
# Канал для autopublish (@username или -100…); бот — админ канала
# TELEGRAM_CHANNEL_ID=
# Optional ngrok hostname for allowedDevOrigins (no https://)
# NEXT_DEV_TUNNEL_HOST=your-subdomain.ngrok-free.dev

# Email OTP — по умолчанию в profile oval-dev: EMAIL_PROVIDER=stub (код в логе app).
# Локально через Mailpit (поднять mailpit из compose.e2e-support или свой):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=oval@localhost.localdomain
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0

# Yandex Postbox (реальная отправка; секреты только в oval-dev.local.env):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your-postbox-identity
# SMTP_PASS=your-api-key
# SMTP_FROM=noreply@your-verified-domain.ru
# EMAIL_OTP_MIN_INTERVAL_SEC=120
# EMAIL_OTP_MAX_PER_EMAIL_PER_DAY=10
# EMAIL_OTP_MAX_SMTP_PER_HOUR=200
