# COMPOSE_PROJECT_NAME=oval-e2e — browser e2e (Playwright)
COMPOSE_PROJECT_NAME=oval-e2e

OVAL_PG_HOST_PORT=15434
OVAL_DB_PASSWORD=oval
NEXT_DEV_HOST_PORT=13001
BETTER_AUTH_URL=http://localhost:13001
PLAYWRIGHT_BASE_URL=http://localhost:13001
MAILSLURPER_UI_HOST_PORT=14436
MAILSLURPER_API_HOST_PORT=14437
MAILSLURPER_SMTP_HOST_PORT=11026

EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=11026
SMTP_FROM=oval@localhost.localdomain
SMTP_USER=
SMTP_PASS=
# MailSlurper (mylslurper) — implicit TLS on 1025; host Playwright uses mapped port.
SMTP_SECURE=1
EMAIL_OTP_MIN_INTERVAL_SEC=60
EMAIL_OTP_MAX_PER_EMAIL_PER_DAY=10
EMAIL_OTP_MAX_SMTP_PER_HOUR=200
BETTER_AUTH_TRUSTED_PROXIES=
OVAL_DISABLE_OTP_LIMITS=1
OVAL_DISABLE_AUTH_RATE_LIMIT=1
PAYMENT_WEBHOOK_SECRET=test-webhook-secret
BETTER_AUTH_SECRET=e2e-test-auth-secret-min-32-chars-long

TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=7000000000:AAE2eTestTelegramBotTokenForPlaywright
TELEGRAM_BOT_USERNAME=oval_e2e_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_INTENT_TTL_SEC=300
TELEGRAM_CHANNEL_ID=
SOCIAL_PUBLISH_MAX_RETRIES=
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_API_ROOT=
TELEGRAM_OIDC_ROOT=
NEXT_DEV_TUNNEL_HOST=
