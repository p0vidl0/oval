ARG PNPM_VERSION=12.9.1

FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9
ARG PNPM_VERSION

RUN npm install -g corepack@0.36.0 && corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
# prepare (`lefthook install`) нужен git-репозиторий; в образе хуков нет.
RUN npm pkg delete scripts.prepare && pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

CMD ["pnpm", "exec", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
